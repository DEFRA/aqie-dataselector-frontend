  <script src="{{ getAssetPath('station-list.js') }}" type="module"></script>
  <script src="{{ getAssetPath('map.js') }}" type="module"></script>
  <script src="{{ getAssetPath('application.js') }}" type="module"></script>
{% endblock %}
