{% extends "govuk/template.njk" %}

{# Import GOVUK components globally #}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "toggletip/macro.njk" import toggletip %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{# Import custom components globally #}
{% from "heading/macro.njk" import appHeading %}
{% from "cookie-banner/macro.njk" import govukCookieBanner %}
{# {% from "govuk/components/footer/macro.njk" import govukFooter -%} #}
{% set mainClasses = "app-main-wrapper" %}

{# GTM noscript iframes: fallback for browsers with JS disabled. Rendered only
   when the request carries an accepted analytics consent cookie, because with
   JS disabled there is no way to gate them client side. #}
{% block bodyStart %}
  {% if analyticsConsent %}
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5ZWS27T3"
      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KBRX8BS5"
      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  {% endif %}
{% endblock %}

{% block head %}
  <link href="{{ getAssetPath('stylesheets/application.scss') }}" rel="stylesheet">
  
{% endblock %}

{% block header %}
  {% include "partials/cookie-banner.njk" %}
  {# Google Tag Manager is NOT loaded here. It is injected by
     cookie-functions.js only after the user accepts analytics cookies, and
     removed again if they reject them. #}
{% from "govuk/components/header/macro.njk" import govukHeader %}


  {{ govukHeader({
    homepageUrl: "https://www.gov.uk/",
    classes: "app-header",
    containerClasses: "govuk-width-container",
    serviceName: serviceName,
    serviceUrl: serviceUrl,
    useTudorCrown: true
  }) }}
  {# {% include "partials/navigation/navigation.njk" %} #}
{% endblock %}

{% block pageTitle %}
  {{ pageTitle }} | Get air pollution data - GOV.UK 
{% endblock %}

{% block beforeContent %}
  {% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}

{{ govukPhaseBanner({
  tag: {
    text: "Beta"
  },
  html: 'This is a new service. Help us improve it and <a class="govuk-link" href="https://defragroup.eu.qualtrics.com/jfe/form/SV_cGUbgnwHQnx28Qu">give your feedback</a>.'
}) }}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
  {% if displayBacklink %}
  <div class='top-nav'>  
    {{ govukBackLink({
    text: "Back",
    href: hrefq
  }) }}
  </div>
{%endif%}
 {% endblock %}
 





{% block content %}{% endblock %}
{% block footer %}

  
  {{ govukFooter({
    meta: {
      items: [
        {
          href: "/privacy",
          text: "Privacy"
        },
        {
          href: "/cookies",
          text: "Cookies"
        },
        {
          href: "/accessibility",
          text: "Accessibility statement"
        }
      ]
    }
  }) }}
{% endblock %}

{% block bodyEnd %}
  <script type="module" src="{{ getAssetPath('application.js') }}"></script>
   {# <script type="module" src="src/client/javascripts/toggletip.js"></script> #}
   <script
  src="https://code.jquery.com/jquery-3.6.0.min.js"
  integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4="
  crossorigin="anonymous"
></script>
{# <script src="/javascript/moj-frontend.min.js"></script> #}
<script>
  window.MOJFrontend.initAll()
</script>


{% endblock %}
