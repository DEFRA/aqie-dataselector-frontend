{% from "govuk/components/cookie-banner/macro.njk" import govukCookieBanner %}
 
{% set html %}
  <p class="govuk-body">We use some essential cookies to make this service work.</p>
  <p class="govuk-body">We'd also like to use analytics cookies so we can understand how you use the service and make improvements.</p>
{% endset %}

{% set acceptHtml %}
  <p class="govuk-body">You’ve accepted analytics cookies. You can  <a class="govuk-link" href="/cookies">change your cookie settings</a> at any time.</p>
{% endset %}

{% set rejectHtml %}
  <p class="govuk-body">You’ve rejected analytics cookies. You can <a class="govuk-link" href="/cookies">change your cookie settings</a>  at any time.</p>
{% endset %}

<form action="/cookies" method="post" novalidate>
  <input type="hidden" name="crumb" value="{{ crumb }}">
  <input type="hidden" name="async" value="false">
  <input type="hidden" name="returnUrl" value="{{ currentPath }}">

{{ govukCookieBanner({
  ariaLabel: "Cookies on Get air pollution data",
  hidden: not showCookieBanner,
  attributes: {
    "data-module": "govuk-cookie-banner",
    "data-crumb": crumb,
    "data-gtm-key": googleTagManagerKeys[0]
  },
  messages: [
    {
      headingText: "Cookies on Get air pollution data ",
      html: html,
      actions: [
        {
          text: "Accept analytics cookies",
          type: "submit",
          name: "analytics",
          value: "true",
          classes: "js-cookie-banner-accept"
        },
        {
          text: "Reject analytics cookies",
          type: "submit",
          name: "analytics",
          value: "false",
          classes: "js-cookie-banner-reject"
        },
        {
          text: "View cookies",
          href: "/cookies/"
        }
      ],
      classes: "app-width-container js-cookie-banner-message"
    },
    {
      html: acceptHtml,
      role: "alert",
      hidden: true,
      actions: [
        {
          text: "Hide cookie message",
          type: "button",
          classes: "js-cookie-banner-hide js-cookie-banner-hide--accept"
        }
      ],
      classes: "js-cookie-banner-confirmation-accept app-width-container"
    },
    {
      html: rejectHtml,
      role: "alert",
      hidden: true,
      actions: [
        {
          text: "Hide cookie message",
          type: "button",
          classes: "js-cookie-banner-hide js-cookie-banner-hide--reject"
        }
      ],
      classes: "js-cookie-banner-confirmation-reject app-width-container"
    }
  ]
}) }}
</form>

{# Inline script hides the banner early (before full JS loads) when the user
   has already given a valid response — avoids a layout shift on return visits.
   Without JS the banner remains visible so no-JS users can still consent. #}
<script>
  window.AQIE_CONSENT_COOKIE_VERSION = 1;

  (function () {
    if (!('noModule' in HTMLScriptElement.prototype)) {
      return
    }

    // Hide on the cookies page — the preference form is shown there instead
    if (window.location.pathname === '/cookies' || window.location.pathname === '/cookies/') {
      var banner = document.querySelector("[data-module='govuk-cookie-banner']")
      if (banner) { banner.setAttribute('hidden', 'true') }
      return
    }

    // Hide when valid consent already recorded
    var match = document.cookie.match(new RegExp('(^| )cookies_policy=([^;]+)'))
    if (match) {
      try {
        var policy = JSON.parse(decodeURIComponent(match[2]))
        if (policy && policy.version >= window.AQIE_CONSENT_COOKIE_VERSION) {
          var banner = document.querySelector("[data-module='govuk-cookie-banner']")
          if (banner) { banner.setAttribute('hidden', 'true') }
        }
      } catch (e) {}
    }
  })()
</script>
