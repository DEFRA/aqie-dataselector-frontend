{% from "toggletip/macro.njk" import toggletip %}

{#
  Yearly air pollution levels table + download links.

  Rendered two ways:
   - included by partials/Yearlytab.njk on the initial page render
   - rendered standalone by /rendertable/{year} and injected into
     #yearlytable-container with innerHTML when the year tab changes

  Scripts inserted via innerHTML never execute, so the behaviour below is
  bound once (on the initial render) and must keep working against markup
  that is replaced later - hence the delegated listeners and the global
  getAPIstn_details1 used by the download links' onclick attributes.

  Limit values and toggletip copy come from the pollutantToggletips,
  dataCaptureToggletip and lowDataCaptureThreshold nunjucks globals
  (src/server/data/en/pollutant-toggletips.js).
#}

{#-------------------------------------------------------------------------
  Reusable markup
--------------------------------------------------------------------------#}
{% macro limitToggletip(entry) %}
  {{ toggletip('', entry.label, entry.text, 'Trend') }}
{% endmacro %}

{% macro aboveLimitTag() %}
  <span class="defra-aq-levels-table__cell--data">
    <strong class="govuk-tag govuk-tag--red govuk-!-font-size-16">Above limit</strong>
  </span>
{% endmacro %}

{#
  An exceedance cell: the count, plus its toggletip and an "Above limit" tag
  when the pollutant has an allowance and the count is over it.
#}
{% macro exceedanceCell(modifier, count, entry) %}
  <td class="defra-aq-levels-table__cell defra-aq-levels-table__cell--{{ modifier }}">
    {% if entry %}
      <span class="defra-aq-value-with-tip">{{ count }}{{ limitToggletip(entry) }}</span>
      {% if entry.limit and count > entry.limit %}{{ aboveLimitTag() }}{% endif %}
    {% else %}
      {{ count }}
    {% endif %}
  </td>
{% endmacro %}

{% macro downloadLink(pollutantKey, pollutantLabel, frequency, actionText) %}
  <a href="#" role="button"
     onclick="getAPIstn_details1('{{ pollutantKey }}', '{{ frequency }}'); return false;"
     class="aq-button-secondary aq-button-secondary--icon govuk-!-margin-bottom-3"
     aria-label="{{ actionText }} for {{ pollutantLabel }}">
    <span class="aq-button-secondary__icon">
      {# Icon defined once as #aq-icon-download in layouts/page.njk #}
      <svg focusable="false" aria-hidden="true" width="14" height="20" viewBox="0 0 14 20">
        <use href="#aq-icon-download"/>
      </svg>
    </span>
    <span class="aq-button-secondary__text">{{ actionText }}</span>
  </a>
{% endmacro %}

{% macro downloadLinksFor(pollutantKey, pollutantLabel) %}
  {{ downloadLink(pollutantKey, pollutantLabel, 'Hourly', 'Download hourly data') }}
  <br>
  {{ downloadLink(pollutantKey, pollutantLabel, 'Daily', 'Download daily average data') }}
  <br>
  {{ downloadLink(pollutantKey, pollutantLabel, 'Annual', 'Download annual average data') }}
{% endmacro %}

<span id="selectedYear" class="display-none">{{ finalyear }}</span>

{# /rendertable sets tabledata to null when the API returns nothing. On the
   initial page render tabledata is undefined and the shell is drawn until
   updateYear() swaps in the real table, so `!== null` is deliberate here. #}
{% if tabledata !== null %}

  <div id="yeartabble">
    <p class="govuk-heading-s">{{ tabledata[0].dataVerifiedTag }}</p>

    <div class="table-scroll-container">
      <table id="aqitable" class="govuk-table defra-aq-levels-table govuk-!-margin-bottom-2">
        <thead class="defra-aq-levels-table__head">
          <tr class="defra-aq-levels-table__row">
            <th scope="col" class="defra-aq-levels-table__cell defra-aq-levels-table__cell--pollutant defra-aq-levels-table__cell--pollutant-title">Pollutant</th>
            <th scope="col" class="defra-aq-levels-table__cell defra-aq-levels-table__cell--average defra-aq-levels-table__cell--average-title">Annual average</th>
            <th scope="col" class="defra-aq-levels-table__cell defra-aq-levels-table__cell--daily defra-aq-levels-table__cell--daily-title">Daily exceedances</th>
            <th scope="col" class="defra-aq-levels-table__cell defra-aq-levels-table__cell--hourly defra-aq-levels-table__cell--hourly-title">Hourly exceedances</th>
          </tr>
        </thead>

        <tbody class="defra-aq-levels-table__body">
          {% for data in tabledata %}
            {% set limits = pollutantToggletips[data.pollutantName] %}
            {% set lowDataCapture = data.dataCapturePercentage < lowDataCaptureThreshold %}

            <tr class="defra-aq-levels-table__row">
              {# Pollutant #}
              <td class="defra-aq-levels-table__cell defra-aq-levels-table__cell--pollutant">
                {{ data.pollutantName }}
                {% if lowDataCapture %}
                  <span class="defra-aq-levels-table__cell--data">
                    <strong class="govuk-tag govuk-tag--red govuk-!-font-size-16">Low data capture</strong>
                  </span>
                {% endif %}
                <span class="defra-aq-levels-table__cell--data defra-aq-levels-table__cell--data-capture">Data capture: {{ data.dataCapturePercentage }}%
                  {% if lowDataCapture %}
                    <span class="defra-toggletip--datacapture">{{ limitToggletip(dataCaptureToggletip) }}</span>
                  {% endif %}
                </span>
              </td>

              {# Annual average. A null limit means the pollutant has no UK limit value. #}
              <td class="defra-aq-levels-table__cell defra-aq-levels-table__cell--average">
                {{ data.annualcount }}
                {% if data.annualcount != '-' and limits.annual %}
                  <span class="defra-aq-value-with-tip">µg/m3{{ limitToggletip(limits.annual) }}</span>
                  {% if limits.annual.limit and data.annualcount > limits.annual.limit and not lowDataCapture %}
                    {{ aboveLimitTag() }}
                  {% endif %}
                {% endif %}
              </td>

              {{ exceedanceCell('daily', data.dailyCount, limits.daily) }}
              {{ exceedanceCell('hourly', data.hourlyCount, limits.hourly) }}
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  <h2 id="year-heading" class="govuk-heading-l govuk-!-margin-top-7 govuk-!-margin-bottom-6">Download data for {{ finalyear }}</h2>

  <details class="govuk-details">
    <summary class="govuk-details__summary">
      <span class="govuk-details__summary-text">Approximate file sizes (CSV)</span>
    </summary>
    <div class="govuk-details__text">
      <p>File sizes for a year of data:</p>
      <ul class="govuk-body govuk-list--bullet">
        <li>hourly data - usually less than 1MB</li>
        <li>daily average data - usually less than 500KB</li>
        <li>annual average data - usually less than 100KB</li>
      </ul>
    </div>
  </details>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h3 class="govuk-heading-m" id="all-p">All pollutants</h3>
      {{ downloadLinksFor('AllPollutants', 'All pollutants') }}

      {% for pollutant in tabledata %}
        <h3 class="govuk-heading-m">{{ pollutant.pollutantName }}</h3>
        {{ downloadLinksFor(pollutant.pollutantName, pollutant.pollutantName) }}
      {% endfor %}
    </div>
  </div>

{% else %}

  <div class="govuk-inset-text">There is no data available for this year.</div>

{% endif %}

{# Only the full page render needs these. On the /rendertable partial route the
   response is injected with innerHTML, where <script> tags never execute, so
   sending them would be ~3KB of dead payload on every year change. The
   handlers bound on the initial render keep working against the new markup. #}
{% if not isPartial %}

<script>
  /*
   * Keep table toggletips inside the viewport.
   *
   * Listeners are delegated from `document` so they survive
   * #yearlytable-container being replaced with innerHTML on a year change.
   */
  (function () {
    if (window.aqTableToggletipsBound) return
    window.aqTableToggletipsBound = true

    var PINNED_CLASS = 'defra-toggletip__info--pinned'
    var EDGE_GAP = 8
    var TIP_GAP = 4
    var MIN_SPACE_ABOVE = 140

    /* The tip's width and its offset from the button are defined in
       _main.scss as custom properties on .defra-toggletip__info. Reading them
       back means restyling the toggletip cannot silently mispostion it. */
    function cssNumber(element, property, fallback) {
      var value = parseFloat(
        getComputedStyle(element).getPropertyValue(property)
      )
      return isNaN(value) ? fallback : value
    }

    function tableToggletipFor(node) {
      if (!node || !node.closest) return null
      var button = node.closest('.defra-toggletip__button')
      if (!button || !button.closest('.table-scroll-container')) return null
      var toggletip = button.closest('.defra-toggletip')
      var info = toggletip && toggletip.querySelector('.defra-toggletip__info')
      return info ? { button: button, info: info } : null
    }

    function reposition(event) {
      var parts = tableToggletipFor(event.target)
      if (!parts) return

      var rect = parts.button.getBoundingClientRect()
      if (!rect.width) return // not visible yet

      var infoWidth = cssNumber(parts.info, '--toggletip-info-width', 200)
      var buttonOffset = cssNumber(parts.info, '--toggletip-info-offset', 85)

      var leftPos = Math.max(EDGE_GAP, rect.left - buttonOffset)
      if (leftPos + infoWidth > window.innerWidth - EDGE_GAP) {
        leftPos = window.innerWidth - infoWidth - EDGE_GAP
      }

      // position/right/z-index come from PINNED_CLASS; only the coordinates,
      // which depend on where the button ended up, have to be inline.
      parts.info.classList.add(PINNED_CLASS)
      var style = parts.info.style
      style.left = leftPos + 'px'

      if (rect.top >= MIN_SPACE_ABOVE) {
        style.top = 'auto'
        style.bottom = window.innerHeight - rect.top + TIP_GAP + 'px'
      } else {
        style.top = rect.bottom + TIP_GAP + 'px'
        style.bottom = 'auto'
      }
    }

    function reset(event) {
      var parts = tableToggletipFor(event.target)
      if (!parts) return
      // Ignore moves between the button and its own children.
      if (event.relatedTarget && parts.button.contains(event.relatedTarget)) return
      parts.info.classList.remove(PINNED_CLASS)
      parts.info.style.cssText = ''
    }

    document.addEventListener('mouseover', reposition)
    document.addEventListener('focusin', reposition)
    document.addEventListener('mouseout', reset)
    document.addEventListener('focusout', reset)
  })()
</script>

<script>
  /*
   * Called from the download links' onclick. Must stay global: the markup
   * that references it is re-injected with innerHTML on a year change,
   * while this script only ever runs on the initial page render.
   */
  function getAPIstn_details1(pollutants, freq) {
    fetch('/downloaddata/' + encodeURIComponent(pollutants) + '/' + encodeURIComponent(freq))
      .then(function (response) { return response.text() })
      .then(function (url) {
        if (url) {
          window.location.href = url
        }
      })
      .catch(function (error) {
        console.error('Error fetching partial content:', error)
      })
  }
</script>

{% if downloadresult %}
  <script>
    window.location.href = {{ downloadresult | dump | safe }}
  </script>
{% endif %}

{% endif %}
