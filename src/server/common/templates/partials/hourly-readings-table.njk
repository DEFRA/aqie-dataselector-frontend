{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "verification-banner/macro.njk" import appVerificationBanner %}

{#
  A collapsed section with one period's hourly readings as a table: the text
  equivalent of the graph. Shared by the graph page and the no-JavaScript
  station page.

  params:
    title               summary text of the section
    table               { caption, head, rows }, as govukTable takes them
    verificationBanner  optional text, shown above the table for pages where
                        the readings are not already under the page's banner
#}
{% macro hourlyReadingsDetails(params) %}
  {% set tableHtml %}
    {% if params.verificationBanner %}
      {{ appVerificationBanner({ text: params.verificationBanner }) }}
    {% endif %}
    <div class="table-scroll-container">
      {{ govukTable({
        caption: params.table.caption,
        captionClasses: "govuk-table__caption--s",
        firstCellIsHeader: true,
        head: params.table.head,
        rows: params.table.rows
      }) }}
    </div>
  {% endset %}

  {{ govukDetails({ summaryText: params.title, html: tableHtml }) }}
{% endmacro %}
