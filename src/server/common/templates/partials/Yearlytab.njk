{% from "toggletip/macro.njk" import toggletip %}
{% set mapToggletip %}
  {{ toggletip(
    '',
    'More information about the trend',
    'This monitoring site is in a city or town close to roads, motorways or highways.
    ',
    'Trend'
  )}}
{% endset %}
{% set isDaqi = activePeriod == 'daqi' %}

{% if isDaqi %}
<h2 id="airpollution-heading" class="govuk-heading-l govuk-!-margin-top-6 govuk-!-margin-bottom-2">{{ daqiContent.heading }}</h2>
{% else %}
<h2 id="airpollution-heading" class="govuk-heading-l govuk-!-margin-top-6 govuk-!-margin-bottom-2">Air pollution levels in {{selectedYear}}</h2>
{% endif %}

{# The current year is still running, so its data only goes up to today.
   Every earlier year is complete. Loose == so a string or numeric year both
   match currentYear. #}
{% if isDaqi %}
<p id="duration_current" class="govuk-body govuk-!-margin-bottom-3">{% if daqi.measuredAt %}{{ daqi.measuredAt | formatDate('d MMMM yyyy') }}{% else %}{{ currentdate }} {{ currentYear }}{% endif %}</p>
{% elif selectedYear == currentYear %}
<p id="duration_current" class="govuk-body govuk-!-margin-bottom-3">1 January to {{currentdate}}</p>
{% else %}
<p id="duration_current" class="govuk-body govuk-!-margin-bottom-3">1 January to 31 December</p>
{% endif %}
 <span id="selectedYear" class="display-none" >{{selectedYear}}</span>
<nav class="moj-sub-navigation" aria-label="Sub navigation">  
  <ul class="moj-sub-navigation__list"  role="tablist">
  <li class="moj-sub-navigation__item">
    <a class="moj-sub-navigation__link" id="link-daqi" href="/stationdetails/daqi" role="tab"
    {% if isDaqi %}
    aria-current="page" aria-selected="true"
    {% else %}
    aria-selected="false"
    {% endif %}>{{ daqiContent.tabLabel }}</a>
  </li>
  <li class="moj-sub-navigation__item">
    <a class="moj-sub-navigation__link" id="link-last-7-days" href="/stationdetails/last-7-days" role="tab" aria-selected="false">Last 7 days</a>
  </li>
  {% for year in years %}
    <li class="moj-sub-navigation__item">
 <a class="moj-sub-navigation__link year-link" id="link-{{ year }}" href="javascript:void(0)" 
 role="tab" aria-controls="panel-{{ year }}"
 data-year="{{ year }}"
 {% if not isDaqi and year == selectedYear %}
 aria-current="page" aria-selected="true"
 {% else %}
 aria-selected="false"
 {% endif %}>
 {{ year }}</a>
    </li>
  {% endfor %}
   
</ul>
          
          </nav>
            <div id="yearlytable-container">
  {% if isDaqi %}
    {% include "partials/daqitable.njk" %}
  {% else %}
    {% include "partials/yearlytable.njk" %}
  {% endif %}
  <noscript>
    <div class="no-js-warning">
      <p>JavaScript is disabled. You are viewing the default data for the selected year.</p>
    </div>
  </noscript>
</div>
      
         <script nonce="{{ nonce }}">
    /* Taken from the server rather than the browser clock, so a client with a
       skewed clock or a different timezone still sees the same date range and
       month name as the server-rendered markup. */
    var CURRENT_YEAR = {{ currentYear | dump | safe }};
    var CURRENT_DATE = {{ currentdate | dump | safe }};
    var DAQI_HEADING = {{ daqiContent.heading | dump | safe }};
    var DAQI_DEFAULT_DATE = {{ (currentdate + ' ' + currentYear) | dump | safe }};
    var DAQI_NO_DATA_MESSAGE = {{ daqiContent.noDataMessage | dump | safe }};
    var LAST_7_DAYS_HEADING = {{ last7DaysContent.heading | dump | safe }};
    var LAST_7_DAYS_NO_DATA_MESSAGE = {{ last7DaysContent.noDataMessage | dump | safe }};

    function showTableError(message) {
      var container = document.getElementById('yearlytable-container');
      if (!container) return;
      var inset = document.createElement('div');
      inset.className = 'govuk-inset-text';
      inset.textContent = message;
      container.replaceChildren(inset);
    }

    function setActiveTab(selectedLink) {
      var links = document.querySelectorAll('.moj-sub-navigation__link');
      links.forEach(function(link) {
          link.removeAttribute('aria-current');
          link.setAttribute('aria-selected', 'false');
      });

      if (selectedLink) {
          selectedLink.setAttribute('aria-current', 'page');
          selectedLink.setAttribute('aria-selected', 'true');
      }
    }

    function updateYear(year) {
      document.getElementById('airpollution-heading').textContent = `Air pollution levels in ${year}`;

      // The current year is still running, so its data only goes up to today.
      var durationEl = document.getElementById('duration_current');
      durationEl.textContent =
          Number(year) === Number(CURRENT_YEAR)
              ? '1 January to ' + CURRENT_DATE
              : '1 January to 31 December';
      durationEl.style.display = '';

      setActiveTab(document.getElementById('link-' + year));

      fetch(`/rendertable/${year}`)
          .then(response => response.text())
          .then(data => {
              document.getElementById('yearlytable-container').innerHTML = data;
          })
          .catch(error => console.error('Error fetching partial content:', error));
    }

    function updateDaqi() {
      document.getElementById('airpollution-heading').textContent = DAQI_HEADING;
      setActiveTab(document.getElementById('link-daqi'));

      fetch('/rendertable/daqi')
          .then(response => {
              if (!response.ok) {
                throw new Error('HTTP ' + response.status);
              }
              return response.text();
          })
          .then(data => {
              document.getElementById('yearlytable-container').innerHTML = data;
              var durationValue = document.getElementById('daqi-duration-value');
              var durationEl = document.getElementById('duration_current');
              if (durationEl) {
                durationEl.textContent = durationValue ? durationValue.textContent : DAQI_DEFAULT_DATE;
                durationEl.style.display = '';
              }
          })
          .catch(error => {
              console.error('Error fetching partial content:', error);
              showTableError(DAQI_NO_DATA_MESSAGE);
          });
    }

    function updateLast7Days() {
      document.getElementById('airpollution-heading').textContent = LAST_7_DAYS_HEADING;
      setActiveTab(document.getElementById('link-last-7-days'));

      fetch('/rendertable/last-7-days')
          .then(response => {
              if (!response.ok) {
                throw new Error('HTTP ' + response.status);
              }
              return response.text();
          })
          .then(data => {
              document.getElementById('yearlytable-container').innerHTML = data;
              var durationValue = document.getElementById('last7days-duration-value');
              var durationEl = document.getElementById('duration_current');
              if (durationEl) {
                durationEl.textContent = durationValue ? durationValue.textContent : '';
                durationEl.style.display = durationValue ? '' : 'none';
              }
          })
          .catch(error => {
              console.error('Error fetching partial content:', error);
              var durationEl = document.getElementById('duration_current');
              if (durationEl) {
                durationEl.textContent = '';
                durationEl.style.display = 'none';
              }
              showTableError(LAST_7_DAYS_NO_DATA_MESSAGE);
          });
    }

    /* Delegated listener for DAQI, Last 7 days and year tab clicks to survive any DOM updates */
    document.querySelector('.moj-sub-navigation__list')?.addEventListener('click', (e) => {
      const daqiLink = e.target.closest('#link-daqi');
      if (daqiLink) {
        e.preventDefault();
        updateDaqi();
        return;
      }

      const last7DaysLink = e.target.closest('#link-last-7-days');
      if (last7DaysLink) {
        e.preventDefault();
        updateLast7Days();
        return;
      }

      const yearLink = e.target.closest('.year-link');
      if (!yearLink) return;
      e.preventDefault();
      const year = yearLink.getAttribute('data-year');
      if (year) {
        updateYear(Number(year));
      }
    });

    // Delegated listener for download buttons to survive innerHTML swaps
    document.getElementById('yearlytable-container')?.addEventListener('click', (e) => {
      const target = e.target.closest('#download-all-hourly, #download-all-daily, #download-all-annual, .download-pollutant');
      if (!target) return;
      e.preventDefault();

      if (target.classList.contains('download-pollutant')) {
        const pollutant = target.getAttribute('data-pollutant');
        const frequency = target.getAttribute('data-frequency');
        getAPIstn_details1(pollutant, frequency);
        return;
      }

      const frequencyById = {
        'download-all-hourly': 'Hourly',
        'download-all-daily': 'Daily',
        'download-all-annual': 'Annual'
      };
      getAPIstn_details1('AllPollutants', frequencyById[target.id]);
    });

    /*
     * Keep table toggletips inside the viewport across all tabs (DAQI, Last 7
     * days and years).
     */
    (function () {
      if (window.aqTableToggletipsBound) return;
      window.aqTableToggletipsBound = true;

      var PINNED_CLASS = 'defra-toggletip__info--pinned';
      var EDGE_GAP = 8;
      var TIP_GAP = 4;
      var MIN_SPACE_ABOVE = 140;

      function cssNumber(element, property, fallback) {
        var value = parseFloat(
          getComputedStyle(element).getPropertyValue(property)
        );
        return isNaN(value) ? fallback : value;
      }

      function tableToggletipFor(node) {
        if (!node || !node.closest) return null;
        var button = node.closest('.defra-toggletip__button');
        if (!button || !button.closest('.table-scroll-container')) return null;
        var toggletip = button.closest('.defra-toggletip');
        var info = toggletip && toggletip.querySelector('.defra-toggletip__info');
        return info ? { button: button, info: info } : null;
      }

      function reposition(event) {
        var parts = tableToggletipFor(event.target);
        if (!parts) return;

        var rect = parts.button.getBoundingClientRect();
        if (!rect.width) return;

        var infoWidth = cssNumber(parts.info, '--toggletip-info-width', 200);
        var buttonOffset = cssNumber(parts.info, '--toggletip-info-offset', 85);

        var leftPos = Math.max(EDGE_GAP, rect.left - buttonOffset);
        if (leftPos + infoWidth > window.innerWidth - EDGE_GAP) {
          leftPos = window.innerWidth - infoWidth - EDGE_GAP;
        }

        parts.info.classList.add(PINNED_CLASS);
        var style = parts.info.style;
        style.left = leftPos + 'px';

        if (rect.top >= MIN_SPACE_ABOVE) {
          style.top = 'auto';
          style.bottom = window.innerHeight - rect.top + TIP_GAP + 'px';
        } else {
          style.top = rect.bottom + TIP_GAP + 'px';
          style.bottom = 'auto';
        }
      }

      function reset(event) {
        var parts = tableToggletipFor(event.target);
        if (!parts) return;
        if (event.relatedTarget && parts.button.contains(event.relatedTarget)) return;
        parts.info.classList.remove(PINNED_CLASS);
        parts.info.style.cssText = '';
      }

      document.addEventListener('mouseover', reposition);
      document.addEventListener('focusin', reposition);
      document.addEventListener('mouseout', reset);
      document.addEventListener('focusout', reset);
    })();

    function getAPIstn_details1(pollutants, freq) {
      fetch('/downloaddata/' + encodeURIComponent(pollutants) + '/' + encodeURIComponent(freq))
        .then(function (response) { return response.text(); })
        .then(function (url) {
          if (url) {
            window.location.href = url;
          }
        })
        .catch(function (error) {
          console.error('Error fetching partial content:', error);
        });
    }
       </script>
