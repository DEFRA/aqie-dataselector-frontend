{% from "toggletip/macro.njk" import toggletip %}
{% set mapToggletip %}
  {{ toggletip(
    '',
    'More information about the trend',
    'This monitoring site is in a city or town close to roads, motorways or highways.
    ',
    'Trend'
  )}}
{% endset %}

<h2 id="airpollution-heading" class="govuk-heading-l govuk-!-margin-top-6 govuk-!-margin-bottom-2">Air pollution levels in {{selectedYear}}</h2>
    
     
     
{# The current year is still running, so its data only goes up to today.
   Every earlier year is complete. Loose == so a string or numeric year both
   match currentYear. #}
{% if selectedYear == currentYear %}
<p id="duration_current" class="govuk-body govuk-!-margin-bottom-3">1 January to {{currentdate}}</p>
{% else %}
<p id="duration_current" class="govuk-body govuk-!-margin-bottom-3">1 January to 31 December</p>
{% endif %}
 <span id="selectedYear" class="display-none" >{{selectedYear}}</span>
<nav class="moj-sub-navigation" aria-label="Sub navigation">  
  <ul class="moj-sub-navigation__list"  role="tablist">
  <li class="moj-sub-navigation__item">
    <a class="moj-sub-navigation__link" id="link-last-7-days" href="/stationdetails/last-7-days" role="tab" aria-selected="false">Last 7 days</a>
  </li>
  {% for year in years %}
    <li class="moj-sub-navigation__item">
 <a class="moj-sub-navigation__link year-link" id="link-{{ year }}" href="javascript:void(0)" 
 role="tab" aria-controls="panel-{{ year }}"
 data-year="{{ year }}"
 {% if year == selectedYear %}
 aria-current="page" aria-selected="true"
 {% else %}
 aria-selected="false"
 {% endif %}>
 {{ year }}</a>
    </li>
  {% endfor %}
   
</ul>
          
          </nav>
            <div id="yearlytable-container">
  {% include "partials/yearlytable.njk" %}
  <noscript>
    <div class="no-js-warning">
      <p>JavaScript is disabled. You are viewing the default data for the selected year.</p>
    </div>
  </noscript>
</div>
      
         <script nonce="{{ nonce }}">
    /* Taken from the server rather than the browser clock, so a client with a
       skewed clock or a different timezone still sees the same date range and
       month name as the server-rendered markup. */
    var CURRENT_YEAR = {{ currentYear | dump | safe }};
    var CURRENT_DATE = {{ currentdate | dump | safe }};
    var LAST_7_DAYS_HEADING = {{ last7DaysContent.heading | dump | safe }};

    function setActiveTab(selectedLink) {
      var links = document.querySelectorAll('.moj-sub-navigation__link');
      links.forEach(function(link) {
          link.removeAttribute('aria-current');
          link.setAttribute('aria-selected', 'false');
      });

      if (selectedLink) {
          selectedLink.setAttribute('aria-current', 'page');
          selectedLink.setAttribute('aria-selected', 'true');
      }
    }

    function updateYear(year) {
      document.getElementById('airpollution-heading').textContent = `Air pollution levels in ${year}`;

      // The current year is still running, so its data only goes up to today.
      var durationEl = document.getElementById('duration_current');
      durationEl.textContent =
          Number(year) === Number(CURRENT_YEAR)
              ? '1 January to ' + CURRENT_DATE
              : '1 January to 31 December';
      durationEl.style.display = '';

      setActiveTab(document.getElementById('link-' + year));

      fetch(`/rendertable/${year}`)
          .then(response => response.text())
          .then(data => {
              document.getElementById('yearlytable-container').innerHTML = data;
          })
          .catch(error => console.error('Error fetching partial content:', error));
    }

    function updateLast7Days() {
      document.getElementById('airpollution-heading').textContent = LAST_7_DAYS_HEADING;
      setActiveTab(document.getElementById('link-last-7-days'));

      fetch('/rendertable/last-7-days')
          .then(response => response.text())
          .then(data => {
              document.getElementById('yearlytable-container').innerHTML = data;
              var durationValue = document.getElementById('last7days-duration-value');
              var durationEl = document.getElementById('duration_current');
              if (durationEl) {
                durationEl.textContent = durationValue ? durationValue.textContent : '';
                durationEl.style.display = durationValue ? '' : 'none';
              }
          })
          .catch(error => console.error('Error fetching partial content:', error));
    }

    /* Delegated listener for year and Last 7 days tab clicks to survive any DOM updates */
    document.querySelector('.moj-sub-navigation__list')?.addEventListener('click', (e) => {
      const last7DaysLink = e.target.closest('#link-last-7-days');
      if (last7DaysLink) {
        e.preventDefault();
        updateLast7Days();
        return;
      }

      const yearLink = e.target.closest('.year-link');
      if (!yearLink) return;
      e.preventDefault();
      const year = yearLink.getAttribute('data-year');
      if (year) {
        updateYear(Number(year));
      }
    });

    /* No DOMContentLoaded work is needed: the selected year's table, headings and
       aria-current/aria-selected state are all rendered server side by
       stationdetails/controller.js. updateYear only runs on a tab click. */

    // Delegated listener for download buttons to survive innerHTML swaps
    document.getElementById('yearlytable-container')?.addEventListener('click', (e) => {
      const target = e.target.closest('#download-all-hourly, #download-all-daily, #download-all-annual, .download-pollutant');
      if (!target) return;
      e.preventDefault();

      if (target.classList.contains('download-pollutant')) {
        const pollutant = target.getAttribute('data-pollutant');
        const frequency = target.getAttribute('data-frequency');
        getAPIstn_details1(pollutant, frequency);
        return;
      }

      const frequencyById = {
        'download-all-hourly': 'Hourly',
        'download-all-daily': 'Daily',
        'download-all-annual': 'Annual'
      };
      getAPIstn_details1('AllPollutants', frequencyById[target.id]);
    });
       </script>
