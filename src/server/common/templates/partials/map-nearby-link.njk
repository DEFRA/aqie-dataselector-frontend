{#
  "View map of nearby monitoring stations" - opens aqie-maps-frontend centred
  on this station with it selected. A form POST (not a link) so the
  coordinates and station id aren't put in a URL, and it works without JavaScript.
  Expects: mapViewUrl (null hides it), stationdetails.
#}
{% set nearbyCoordinates = stationdetails.location.coordinates if stationdetails.location else null %}
{% if mapViewUrl and nearbyCoordinates %}
<form class="aq-map-nearby govuk-!-margin-top-4 govuk-!-margin-bottom-2" method="post" action="{{ mapViewUrl }}">
  <input type="hidden" name="lat" value="{{ nearbyCoordinates[0] }}">
  <input type="hidden" name="lng" value="{{ nearbyCoordinates[1] }}">
  {% if stationdetails.localSiteID %}
  <input type="hidden" name="siteId" value="{{ stationdetails.localSiteID }}">
  {% endif %}
  <button type="submit" class="aq-map-nearby__link govuk-link" id="view-nearby-map">
    <svg class="aq-map-nearby__icon" aria-hidden="true" focusable="false" width="16" height="22" viewBox="0 0 16 22">
      <path d="M8 0C3.6 0 0 3.5 0 7.9 0 13.6 8 22 8 22s8-8.4 8-14.1C16 3.5 12.4 0 8 0Zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"/>
    </svg>
    View map of nearby monitoring stations
  </button>
</form>
{% endif %}
