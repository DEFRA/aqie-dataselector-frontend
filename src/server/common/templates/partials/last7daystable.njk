{% from "partials/pollutant-summary-table.njk" import pollutantSummaryTable %}
{% from "verification-banner/macro.njk" import appVerificationBanner %}

{#
  Last 7 days air pollution levels table.

  `last7Days` comes from stationdetails/controller.js's last7DaysController:
  { periodStart, periodEnd, latestReadingAt, pollutants: [{ pollutantName,
  dataCapturePercentage, lowDataCapture, average, dailyCount, hourlyCount }] },
  mapped from aqie-back-end's /monitoringStationHistory `summary` by
  last-7-days-summary.js. The back end decides whether an average exists (75%
  data capture); a withheld average arrives as '-' and `lowDataCapture` is true,
  so the tag and the dash always agree.

  The table is partials/pollutant-summary-table.njk, shared with the other
  periods; its comment covers the toggletip copy.

  The heading and date range are rendered by stationdetails/last-7-days.njk,
  above the period nav, so this partial starts at the notice banner.
#}

{% if durationText %}
  <span id="last7days-duration-value" class="display-none">{{ durationText }}</span>
{% endif %}

{% if last7Days.pollutants.length %}

  {{ appVerificationBanner({ text: last7DaysContent.notice }) }}

  {{ pollutantSummaryTable({ rows: last7Days.pollutants, period: '7d', id: 'last7daystable' }) }}

  <p id="last7days-hint" class="govuk-hint">The pollution levels shown are measured against UK legal limits.</p>

{% elif last7Days.noMapping %}

  <div class="govuk-inset-text">{{ last7DaysContent.noMappingMessage }}</div>

{% else %}

  <div class="govuk-inset-text">{{ last7DaysContent.noDataMessage }}</div>

{% endif %}
