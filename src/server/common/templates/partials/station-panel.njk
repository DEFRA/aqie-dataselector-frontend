<div id="station-panel" class="aq-map-info" tabindex="-1" role="dialog" aria-modal="true"
  aria-label="Station information" data-dataselector-url="{{ dataSelectorUrl }}">
  <button id="sp-close" class="aq-map-info__close" aria-label="Close station information">
    <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 20 20">
      <path d="M10,8.6L15.6,3L17,4.4L11.4,10L17,15.6L15.6,17L10,11.4L4.4,17L3,15.6L8.6,10L3,4.4L4.4,3L10,8.6Z"
        style="fill:currentColor" />
    </svg>
    <span class="govuk-visually-hidden">Close</span>
  </button>
  <div class="aq-map-info__container">
    <div class="aq-station-header">
      <h2 class="govuk-heading-m govuk-!-margin-bottom-0" id="sp-name"></h2>
    </div>
    <dl class="aq-station-info-list govuk-body-s govuk-!-margin-top-2" id="sp-details"></dl>
    <div class="govuk-!-margin-top-4 govuk-!-border-top-1 govuk-!-border-top-grey-2 govuk-!-padding-top-2">
      <!-- POSTed (not a plain GET link) so lat/lng/name aren't exposed in the URL, browser history or server logs -->
      <form id="sp-station-form" method="post" hidden>
        <input type="hidden" name="lat">
        <input type="hidden" name="lng">
        <input type="hidden" name="name">
      </form>
      <a href="#" id="sp-station-link" class="govuk-link">View full station summary</a>
    </div>
  </div>
</div>
