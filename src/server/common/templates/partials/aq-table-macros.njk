{% from "toggletip/macro.njk" import toggletip %}

{#
  Shared macros for the pollutant-levels tables (yearlytable.njk and
  last7daystable.njk). An entry is `{ limit, label, text }` from
  pollutant-toggletips.js or last-7-days.js; `limit` is optional - omitting it
  suppresses the "Above limit" tag (used by last7daystable.njk, which has no
  per-calendar-year allowance to compare a 7-day count against).
#}

{% macro limitToggletip(entry) %}
  {{ toggletip('', entry.label, entry.text, 'Trend') }}
{% endmacro %}

{% macro aboveLimitTag() %}
  <span class="defra-aq-levels-table__cell--data">
    <strong class="govuk-tag govuk-tag--red govuk-!-font-size-16">Above limit</strong>
  </span>
{% endmacro %}

{#
  The 7-day table's variants. The text goes inside the toggletip, so the icon is
  part of the same inline unit as the value: it stays on the value's line when
  the table narrows and sits on the text's centre line.
#}
{% macro inlineToggletip(text, entry) %}
  <span class="defra-aq-value-with-tip">{{ toggletip(text, entry.label, entry.text, 'Trend') }}</span>
{% endmacro %}

{% macro inlineExceedanceCell(modifier, count, entry) %}
  <td class="defra-aq-levels-table__cell defra-aq-levels-table__cell--{{ modifier }}">
    {% if entry %}
      {{ inlineToggletip(count, entry) }}
      {% if entry.limit and count > entry.limit %}{{ aboveLimitTag() }}{% endif %}
    {% else %}
      {{ count }}
    {% endif %}
  </td>
{% endmacro %}

{#
  An exceedance cell: the count, plus its toggletip and an "Above limit" tag
  when the entry has a limit and the count is over it.
#}
{% macro exceedanceCell(modifier, count, entry) %}
  <td class="defra-aq-levels-table__cell defra-aq-levels-table__cell--{{ modifier }}">
    {% if entry %}
      <span class="defra-aq-value-with-tip">{{ count }}{{ limitToggletip(entry) }}</span>
      {% if entry.limit and count > entry.limit %}{{ aboveLimitTag() }}{% endif %}
    {% else %}
      {{ count }}
    {% endif %}
  </td>
{% endmacro %}
