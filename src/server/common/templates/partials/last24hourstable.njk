{% from "partials/aq-table-macros.njk" import limitToggletip, exceedanceCell %}

{#
  Last 24 hours air pollution levels table. Takes the same approach as
  last7daystable.njk (same data shape, from resolveLast24Hours), with these
  differences:
  - `dailyCount` is not shown.
  - Hourly exceedances use last24HoursLimits[name].hourly
    (src/server/data/en/last-24-hours.js), which has no annual `limit`, so no
    "Above limit" tag is drawn against a single day's count.
  - The heading and date are rendered by Yearlytab.njk; `durationText` is
    today's date.
#}

{% if durationText %}
  <span id="last24hours-duration-value" class="display-none">{{ durationText }}</span>
{% endif %}

{% if last24Hours.pollutants.length %}

  <div class="govuk-inset-text not-verified">{{ last24HoursContent.notice }}</div>

  <div class="table-scroll-container">
    <table id="last24hourstable" class="govuk-table defra-aq-levels-table govuk-!-margin-bottom-2">
      <thead class="defra-aq-levels-table__head">
        <tr class="defra-aq-levels-table__row">
          <th scope="col" class="defra-aq-levels-table__cell defra-aq-levels-table__cell--pollutant defra-aq-levels-table__cell--pollutant-title">Pollutant</th>
          <th scope="col" class="defra-aq-levels-table__cell defra-aq-levels-table__cell--average defra-aq-levels-table__cell--average-title">24 hour average</th>
          <th scope="col" class="defra-aq-levels-table__cell defra-aq-levels-table__cell--hourly defra-aq-levels-table__cell--hourly-title">Hourly exceedances</th>
        </tr>
      </thead>

      <tbody class="defra-aq-levels-table__body">
        {% for data in last24Hours.pollutants %}
          {% set hourlyLimit = last24HoursLimits[data.pollutantName].hourly %}
          {% set annualLimit = pollutantToggletips[data.pollutantName].annual %}
          {% set lowDataCapture = data.lowDataCapture %}

          <tr class="defra-aq-levels-table__row">
            <td class="defra-aq-levels-table__cell defra-aq-levels-table__cell--pollutant">
              {{ data.pollutantName }}
              {% if lowDataCapture %}
                <span class="defra-aq-levels-table__cell--data">
                  <strong class="govuk-tag govuk-tag--red govuk-!-font-size-16">Low data capture</strong>
                </span>
              {% endif %}
              <span class="defra-aq-levels-table__cell--data defra-aq-levels-table__cell--data-capture">Data capture: {{ data.dataCapturePercentage }}%
                {% if lowDataCapture %}
                  <span class="defra-toggletip--datacapture">{{ limitToggletip(dataCaptureToggletip) }}</span>
                {% endif %}
              </span>
            </td>

            <td class="defra-aq-levels-table__cell defra-aq-levels-table__cell--average">
              {% if data.average != '-' and annualLimit %}
                <span class="defra-aq-value-with-tip">{{ data.average }} µg/m3{{ limitToggletip(annualLimit) }}</span>
              {% else %}
                {{ data.average }}
              {% endif %}
            </td>

            {{ exceedanceCell('hourly', data.hourlyCount, hourlyLimit) }}
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <p id="last24hours-hint" class="govuk-hint">{{ last24HoursContent.legalLimitsHint }}</p>

{% elif last24Hours.noMapping %}

  <div class="govuk-inset-text">{{ last24HoursContent.noMappingMessage }}</div>

{% else %}

  <div class="govuk-inset-text">{{ last24HoursContent.noDataMessage }}</div>

{% endif %}
