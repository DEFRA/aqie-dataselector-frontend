{% extends 'layouts/page.njk' %}
{% set displayBreadcrumbs = false %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl govuk-!-margin-bottom-6">{{ title }}</h1>

      <p class="govuk-body">
        Station: {{ stationdetails.name if stationdetails else stationId }}
      </p>

      <p class="govuk-body">
        Period: {{ periodLabel }}
      </p>

      <p class="govuk-body">
        This is the graph and pollutant summary destination page for the
        selected station.
      </p>
    </div>
  </div>
{% endblock %}
