{% extends 'layouts/page.njk' %}
{% set displayBreadcrumbs = false %}

{% block content %}

{% include "partials/station-header.njk" %}

<h2 id="last7days-heading" class="govuk-heading-l govuk-!-margin-top-6 govuk-!-margin-bottom-2">{{ last7DaysContent.heading }}</h2>

{% if last7Days.pollutants.length %}
  <p id="last7days-duration" class="govuk-body govuk-!-margin-bottom-3">
    {{ last7Days.periodStart | formatDate('d MMMM') }} to {{ last7Days.periodEnd | formatDate('d MMMM yyyy') }}
  </p>
{% endif %}

<nav class="moj-sub-navigation" aria-label="Sub navigation">
  <ul class="moj-sub-navigation__list">
    <li class="moj-sub-navigation__item">
      <a class="moj-sub-navigation__link" href="/stationdetails/last-7-days" aria-current="page">Last 7 days</a>
    </li>
    {# Plain links back to /stationdetails: the year tabs' client-side swap
       (Yearlytab.njk's updateYear()) only runs on that page, so a year link
       here does a full navigation back to whichever year is already
       selected in session, rather than attempting to deep-link a specific
       year from this page. #}
    {% for year in years %}
      <li class="moj-sub-navigation__item">
        <a class="moj-sub-navigation__link" href="/stationdetails/year/{{ year }}">{{ year }}</a>
      </li>
    {% endfor %}
  </ul>
</nav>

{% include "partials/last7daystable.njk" %}

{% endblock %}
