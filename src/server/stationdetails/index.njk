{% extends 'layouts/page.njk' %}
{% set displayBreadcrumbs = false %}
{% from "govuk/components/table/macro.njk" import govukTable %}
 {% from "govuk/components/tabs/macro.njk" import govukTabs %}
   
<script src="/path/to/govuk-frontend/govuk/all.js"></script>

  <script nonce="{{ nonce }}">
    document.addEventListener('DOMContentLoaded', function() {
      window.GOVUKFrontend.initAll();
    });
    
       
        
    
  </script>
{% block content %}

    
 {% set mapToggletip %}
  {{ toggletip(
    '',
    'More information about ' + stationdetails.siteType,
    maptoggletips
    ,
    'Trend'
  )}}
{% endset %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
<h1 class="govuk-heading-xl govuk-!-margin-bottom-1">{{stationdetails.name}}</h1>   



        <strong class="govuk-tag status-tag govuk-tag--green">
            Active
          </strong>
          <p class="status-description govuk-!-margin-top-3" id="status">Latest at {{updatedTime}}</p>
</div>
</div>
          <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
          <dl class="defra-aq-features__list govuk-!-margin-top-3">
            <div class="defra-aq-features__item" >
              <dt class="defra-aq-features__key " >Monitoring network</dt>
              <dd class="defra-aq-features__value govuk-body" >Automatic Urban and Rural Network (AURN)</dd>
            </div>
            <div class="defra-aq-features__item" >
              <dt class="defra-aq-features__key " >Region</dt>
              <dd class="defra-aq-features__value govuk-body" >{{stationdetails.region}}</dd>
            </div>
            <div class="defra-aq-features__item" >
              <dt class="defra-aq-features__key ">Site type</dt>
             
              <dd class="defra-aq-features__value govuk-body defra-aq-features__value--wrap">
  <span class="defra-aq-value-with-tip">
    <span class="defra-aq-features__value-text">{{ stationdetails.siteType }}</span>
    <span class="defra-aq-features__value-tip">{{ mapToggletip | safe }}</span>
  </span>

  <p class="govuk-body govuk-!-margin-top-1">
    <a href={{maplocation}} class="govuk-link" target="_blank">View on Google Maps (opens in new tab)</a>
  </p>
</dd>
             
            </div>
            </dl>
            
        {% include "partials/Yearlytab.njk" %}

        {% if viewGraphSummary %}
          <div class="govuk-!-margin-top-6 govuk-!-margin-bottom-6">
            <h2 class="govuk-heading-m govuk-!-margin-bottom-3">{{ viewGraphSummary.title }}</h2>
            <a
              href="{{ viewGraphSummary.href }}"
              class="govuk-button govuk-button--secondary govuk-button--start govuk-!-margin-bottom-0 govuk-!-padding-right-4"
              role="button"
              draggable="false"
            >
              <svg
                aria-hidden="true"
                focusable="false"
                class="govuk-button__icon"
                width="20"
                height="20"
                viewBox="0 0 20 20"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path d="M2.5 15.5H17.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M4 13.5V10.5M8 13.5V7.5M12 13.5V5.5M16 13.5V8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M3 3.5H17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              <span>{{ viewGraphSummary.buttonText }}</span>
            </a>
          </div>
        {% endif %}

  <script nonce="{{ nonce }}">
  (function () {
    var base = window.devicePixelRatio || 1;
    function updateZoomFlag() {
      var dpr = window.devicePixelRatio || 1;
      var zoomed = Math.abs(dpr - base) > 0.05;
      document.body.classList.toggle('is-zoomed', zoomed);
    }
    window.addEventListener('resize', updateZoomFlag);
    window.addEventListener('orientationchange', updateZoomFlag);
    updateZoomFlag();
  })();
</script>
{% endblock %}
