{% extends 'layouts/page.njk' %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "verification-banner/macro.njk" import appVerificationBanner %}
{% from "partials/pollutant-summary-table.njk" import pollutantSummaryTable %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-xl govuk-!-margin-bottom-{{ 2 if dates else 4 }}">{{ heading }}</h1>

      {% if dates %}
        <p class="govuk-body govuk-!-margin-bottom-4">{{ dates }}</p>
      {% endif %}

      <nav class="moj-sub-navigation" aria-label="{{ periodNavigationLabel }}">
        <ul class="moj-sub-navigation__list">
          {% for tab in periodTabs %}
            <li class="moj-sub-navigation__item">
              <a class="moj-sub-navigation__link" href="{{ tab.href }}"{% if tab.isCurrent %} aria-current="page"{% endif %}>{{ tab.label }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>

      {{ appVerificationBanner({ text: verificationBanner }) }}

      {% set summaryHtml %}
        {% if summary.rows.length %}
          {{ pollutantSummaryTable({ rows: summary.rows, period: summary.period, id: 'pollutant-summary-table', limitToggletips: false }) }}
          <p class="govuk-body-s">{{ summary.legalLimits }}</p>
        {% else %}
          <p class="govuk-body">{{ summary.message }}</p>
        {% endif %}
      {% endset %}

      {{ govukDetails({ summaryText: summary.title, html: summaryHtml }) }}
    </div>
  </div>
{% endblock %}
