{% extends 'layouts/page.njk' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">
      <h1 class="govuk-heading-xl">{{ title }}</h1>

      <p class="govuk-body">
        This accessibility statement applies to the
        <a class="govuk-link" href="/hubpage">Get air pollution data</a>
        website.
      </p>

      <p class="govuk-body">{{ texts.a }} {{ texts.b }}</p>
      <p class="govuk-body">{{ texts.c }}</p>

      <ul class="govuk-list govuk-list--bullet">
        <li>{{ texts.d }}</li>
        <li>{{ texts.e }}</li>
        <li>{{ texts.f }}</li>
        <li>{{ texts.g }}</li>
        <li>{{ texts.h }}</li>
      </ul>

      <p class="govuk-body">{{ texts.i }}</p>
      <p class="govuk-body">
        <a class="govuk-link" href="https://mcmw.abilitynet.org.uk/">AbilityNet</a>
        has advice on making your device easier to use if you have a disability.
      </p>
      <p class="govuk-body">{{ texts.k }}</p>

      <h2 class="govuk-heading-l">{{ texts.l }}</h2>
      <p class="govuk-body">
        {{ texts.m | replace('Web Content Accessibility Guidelines version 2.2 AA standard.', '') }}
        <a class="govuk-link" href="https://www.w3.org/TR/WCAG22/">Web Content Accessibility Guidelines version 2.2 AA standard</a>.
      </p>
      <p class="govuk-body">{{ texts.n }}</p>
      <p class="govuk-body">{{ texts.o }}</p>

      <ul class="govuk-list govuk-list--bullet">
        <li>{{ texts.p }}</li>
        <li>{{ texts.q }}</li>
      </ul>

      <h2 class="govuk-heading-l">{{ texts.r }}</h2>
      <p class="govuk-body">{{ texts.s }}</p>
      <p class="govuk-body">{{ texts.t }}</p>
      <p class="govuk-body">{{ texts.u }}</p>

      <h2 class="govuk-heading-l">{{ texts.v }}</h2>
      <p class="govuk-body">{{ texts.w }}</p>
      <p class="govuk-body">{{ texts.x }}</p>
      <p class="govuk-body">{{ texts.y }}</p>

      <h2 class="govuk-heading-l">{{ texts.z }}</h2>
      <p class="govuk-body">
        If you notice any compliance failures or need to request information and
        content that is not provided in this document, email
        <a class="govuk-link" href="mailto:accessibility@defra.gov.uk">accessibility@defra.gov.uk</a>.
      </p>

      <h2 class="govuk-heading-l">{{ texts.ab }}</h2>
      <p class="govuk-body">{{ texts.ac }}</p>
      <p class="govuk-body">
        If you are not happy with how Defra responds to your complaint, contact the
        <a class="govuk-link" href="https://www.equalityadvisoryservice.com/">Equality Advisory and Support Service (EASS)</a>.
      </p>
    </div>
  </div>

{% endblock %}
