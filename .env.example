# Google Tag Manager
# GTM container ID — override via env var without a code deploy.
GOOGLE_TAG_MANAGER_KEYS=GTM-KBRX8BS5

# Google Analytics 4
# GA4 measurement IDs are configured as tags inside the GTM container above,
# not directly in this application. No env var is needed here.

# Feature flags (all off by default; set to true to enable)
# Graph summary button and page on station details
VIEW_GRAPH_SUMMARY_ENABLED=true
# DAQI tab on station details, shown as the default tab
VIEW_DAQI_TAB_ENABLED=true
# "Search on a map" link on the hub page (also needs MAPS_FRONT_END_URL)
SEARCH_ON_MAP_ENABLED=true
# Serve the map (/map and its /api routes) from this service instead of linking to aqie-maps-frontend
MAP_IN_DATASELECTOR_ENABLED=true
# Fetch map forecasts from the forecast API; while off, /api/forecasts returns []
MAP_FORECASTS_ENABLED=false

# Local Setup
OS_NAMES_DEV_API_KEYS=****Placeholder*****

SESSION_COOKIE_PASSWORD=

# aqie-maps-frontend base URL for the hub link and the station page Back link
MAPS_FRONT_END_URL=http://localhost:3000

# aqie-back-end base URL, used by the map for station, AURN and forecast data.
# Required locally; in CDP it defaults to aqie-back-end in the current ENVIRONMENT
AQIE_BACK_END_URL=http://localhost:3001
# Optional: forecast API base URL, used by the map. Falls back to aqie-back-end's /forecasts when unset
AQIE_FORECAST_API_URL=
