# Google Tag Manager
# GTM container ID — override via env var without a code deploy.
GOOGLE_TAG_MANAGER_KEYS=GTM-KBRX8BS5

# Google Analytics 4
# GA4 measurement IDs are configured as tags inside the GTM container above,
# not directly in this application. No env var is needed here.

# Feature flags
VIEW_GRAPH_SUMMARY_ENABLED=true

# Local Setup
OS_NAMES_DEV_API_KEYS=****Placeholder*****
